{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "shared.js",
        "content.js"
      ]
    }
  ],
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "default_locale": "en"
}
