{
  "manifest_version": 3,
  "name": "Shorts Blocker for YouTube",
  "version": "0.1.0",
  "description": "블랙리스트에 등록된 채널의 숏츠 재생을 자동으로 일시정지합니다.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "shared.js",
        "content.js"
      ]
    }
  ],
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  }
}
